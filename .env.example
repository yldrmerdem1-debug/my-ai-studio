# Copy this file to .env.local and fill in only the providers you use.
# Never commit real credentials.

# App URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_ENABLE_FACE_SWAP=false
ENABLE_FACE_SWAP=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access
# Add the email of the account that should manage the platform.
ADMIN_EMAILS=owner@example.com
ADMIN_USER_IDS=

# Storage
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_S3_API_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# AI providers
REPLICATE_API_TOKEN=
GEMINI_API_KEY=
FAL_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1

# Replicate model configuration
REPLICATE_FLUX_LORA_MODEL=
REPLICATE_FLUX_MULTI_LORA_MODEL=
# Nano Banana (Google Gemini image models on Replicate). Defaults used if blank.
REPLICATE_NANO_BANANA_MODEL=google/nano-banana
REPLICATE_NANO_BANANA_2_MODEL=google/nano-banana-2
# Nano Banana Pro (Gemini 3 Pro Image) — strongest identity refiner for digital twins.
REPLICATE_NANO_BANANA_PRO_MODEL=google/nano-banana-pro
# Human persona video/Auto-Editor anchors use LoRA first, then Nano Banana Pro refinement by default.
ENABLE_VIDEO_NANO_PRO_REFINER=true
REPLICATE_HIGH_QUALITY_LORA_MODEL=
REPLICATE_FACE_SWAP_MODEL=
REPLICATE_VEO_MODEL=
REPLICATE_VEO_FALLBACK_MODEL=
REPLICATE_GROK_VIDEO_MODEL=
# ByteDance Seedance 2.0 video model on Replicate. Defaults to bytedance/seedance-2.0 if blank.
REPLICATE_SEEDANCE_2_0_MODEL=bytedance/seedance-2.0
REPLICATE_FLUX_TRAINING_BASE_MODEL=
REPLICATE_FLUX_TRAINING_VERSION=
REPLICATE_FLUX_TRAINING_DESTINATION_MODEL=
# Legacy alias still supported as a training destination fallback.
REPLICATE_TRAINING_MODEL=

# Persona generation / training
PERSONA_TRAINING_PROVIDER_ORDER=
NEXT_PUBLIC_PERSONA_USER_ID=
PERSONA_ANCHOR_CANDIDATES=
PERSONA_ANCHOR_STEPS=
PERSONA_ANCHOR_GUIDANCE=
PERSONA_HQ_LORA_STEPS=

# xAI video options
XAI_VIDEO_MODEL=grok-imagine-video
XAI_VIDEO_RESOLUTION=720p
XAI_VIDEO_ASPECT_RATIO=16:9
XAI_VIDEO_TIMEOUT_MS=600000
XAI_VIDEO_POLL_MS=2000

# Hugging Face migration / hosting
HF_TOKEN=
HF_REPO_ID=
HF_REPO_TYPE=model

# Runtime tuning
VIDEO_RATE_LIMIT_PER_MIN=12
VIDEO_MAX_PER_USER_CONCURRENT=2
VIDEO_MAX_GLOBAL_CONCURRENT=40
ALLOW_LOCAL_ASSET_FALLBACK=false